# Скопируйте этот файл в .env и заполните нужный блок.

# ---------- Общие настройки ----------
# Провайдер нейросети: mock | openai-compatible | gigachat | yandexgpt
# mock — работает без сети и ключей, находит поля правилами. Для демонстрации и тестов.
LLM_PROVIDER=mock
PORT=8850
# Адрес, на котором слушать. На сервере за Caddy — 127.0.0.1 (доступ только через HTTPS с паролем)
# HOST=127.0.0.1
# Сколько символов документации отправлять в модель за один запрос.
# Для моделей с контекстом 32k токенов подходит 24000; для 8k — ставьте 6000.
LLM_MAX_CHARS_PER_CHUNK=24000
# Таймаут одного запроса к модели, мс
LLM_TIMEOUT_MS=180000
LLM_TEMPERATURE=0.1
# Лимит ответа модели в токенах (для gigachat/yandexgpt по умолчанию 8000)
# LLM_MAX_TOKENS=8000
MAX_UPLOAD_MB=100

# ---------- Поиск тендеров ----------
# gosplan — ГосПлан API; fixture — сохранённые закупки из samples/tenders (без сети)
TENDER_SOURCE=gosplan
# Тестовый сервер работает без ключа (базовые лимиты). Боевой: https://v2.gosplan.info + GOSPLAN_API_KEY
GOSPLAN_BASE_URL=https://v2test.gosplan.info
# Ключ — через Telegram-бота ГосПлана (https://gosplan.info), 7 дней бесплатно
GOSPLAN_API_KEY=
# Какие законы загружать
GOSPLAN_LAWS=44,223
# Максимум страниц (по 100 закупок) на один закон и одно ключевое слово за синхронизацию
GOSPLAN_MAX_PAGES=10
# Пауза между запросами к API, мс
GOSPLAN_REQUEST_DELAY_MS=400
# Как часто забирать новые закупки, минуты (0 — только вручную)
SYNC_INTERVAL_MIN=60
# За сколько дней загрузить закупки при самой первой синхронизации
SYNC_FIRST_DAYS=3
# Сколько закупок оценивать нейросетью за один запрос
SCORE_BATCH_SIZE=10

# ---------- Выгодность (этап 3) ----------
# Сколько прошлых контрактов открывать для рыночного ориентира по одному коду товара
BENCHMARK_MAX_CONTRACTS=15
# По скольким прошлым торгам оценивать типичное снижение цены (нужно минимум 3, иначе — значение из профиля)
BENCHMARK_DECLINE_SAMPLES=5
# Сколько дней хранить ориентир по коду товара
BENCHMARK_CACHE_DAYS=7
# Для скольких лучших закупок считать выгодность в фоне после каждой синхронизации (0 — только по кнопке)
ECONOMICS_MAX_PER_SYNC=30
# Тестовый сервер ГосПлан жёстко ограничивает частоту запросов. Для него удобнее:
#   GOSPLAN_REQUEST_DELAY_MS=2500  BENCHMARK_MAX_CONTRACTS=8  BENCHMARK_DECLINE_SAMPLES=3  ECONOMICS_MAX_PER_SYNC=5

# ---------- Поиск поставщиков (этап 4) ----------
# Какие источники использовать: contracts (прошлые госконтракты), photo (поиск по фото из ТЗ), yandex (поиск в интернете), b2b (B2B-каталоги через поиск site:), stores (config/stores.json), manual
OFFER_SOURCES=contracts,photo,yandex,b2b,stores,manual
# Яндекс Search API (Yandex Cloud / AI Studio): обычная выдача без рекламы. Нужен API-ключ сервисного аккаунта
# с ролью search-api.webSearch.user и ID каталога. Платно за 1000 запросов — актуальные цены проверьте на сайте Yandex Cloud.
YANDEX_SEARCH_API_KEY=
# ID каталога Yandex Cloud (тот же, что для YandexGPT, если используете его)
YANDEX_FOLDER_ID=
# DaData — проверка продавцов по ЕГРЮЛ. Бесплатно до 10 000 запросов в день (проверьте на dadata.ru). Ключ — в личном кабинете.
DADATA_API_KEY=
# Лимиты расходов на один поиск
SEARCH_MAX_QUERIES_PER_ITEM=5
SEARCH_RESULTS_PER_QUERY=10
SEARCH_MAX_API_REQUESTS=20
SEARCH_MAX_PAGES=90
# Страниц на одну позицию. Открываются бесплатно, плата — время (около 5 секунд на страницу)
SEARCH_MAX_PAGES_PER_ITEM=24
# Страницы крупнее этого (в байтах) не читаются
# FETCH_MAX_BYTES=3145728
# Не чаще одного запроса к одному сайту за столько миллисекунд
FETCH_MIN_INTERVAL_MS=2000
# Ниже этого доверия предложение не подставляется в расчёт автоматически
SELLER_TRUST_THRESHOLD=60
SELLER_CHECK_CACHE_DAYS=30
# Домены, которые не открывать (через запятую)
# OFFER_DOMAIN_BLOCKLIST=zakupki.gov.ru,otzovik.com,irecommend.ru,youtube.com,vk.com
# Список магазинов, оптовых поставщиков (suppliers), розничных сетей (retail) и дистрибьюторов
# STORES_CONFIG=config/stores.json
# Свой каталог страниц оптовых поставщиков (по картам сайтов): 0 — выключить; как часто перечитывать сайт, дней
# SUPPLIER_INDEX=1
# SUPPLIER_INDEX_MAX_AGE_DAYS=7
# Сколько страниц поставщиков из каталога открыть по моделям из ТЗ и сколько — «дожимая» цену на подошедший товар
# SEARCH_WHOLESALE_PAGES=8
# SEARCH_SWEEP_PAGES=6
# Сверка с ТЗ: «соответствует» — только когда подтверждены все требования; доля подтверждённых для «частично»
# MATCH_PART_SHARE=0.3
# Доставка перевозчиком: тарифная сетка и вес/объём по умолчанию (оценка, не тарифы перевозчиков)
# LOGISTICS_CONFIG=config/logistics.json
# Автоматическая проверка продавцов по реестру недобросовестных поставщиков ЕИС (0 — выключить),
# скольких проверять за обновление ленты и через сколько дней перепроверять
# RNP_AUTO=1
# RNP_CHECK_PER_SYNC=10
# RNP_RECHECK_DAYS=14
# Поиск продавца по ИНН в реестре недобросовестных поставщиков ЕИС ({inn} — ИНН)
# RNP_SEARCH_URL=https://zakupki.gov.ru/epz/dishonestsupplier/search/results.html?searchString={inn}
# Профильные компании для запроса цены (кандидаты, не предложения)
# SUPPLIER_CANDIDATES_CONFIG=config/profile-suppliers.json
# Сколько ждать чтения ТЗ из документации перед поиском по кнопке, мс
# SEARCH_TZ_WAIT_MS=480000

# Площадка закупки (куда подавать заявку) есть только в подробностях закупки — сервис узнаёт её в фоне:
# у скольких закупок за одно обновление ленты (0 — не узнавать). Сразу для всей ленты: POST /api/platforms/fill
# PLATFORM_FETCH_PER_SYNC=30
# Сверка этапа закупок из ленты с ЕИС по номеру (отменённые уходят из ленты): сколько за проход и раз во сколько часов
# STAGE_CHECK_PER_SYNC=10
# STAGE_CHECK_HOURS=24
# Извещение «не найдено» в ГосПлане (свежая закупка из ленты ЕИС): сколько за проход спрашивать снова и раз во сколько минут
# NOTICE_RETRY_PER_SYNC=15
# NOTICE_RETRY_MINUTES=60

# ---------- Перепродажа (этап 5) ----------
# Режим включается в «Профиль → Режим поиска закупок». Правила отсева работ, услуг и лицензируемых товаров:
# RESALE_EXCLUSIONS=config/resale-exclusions.json
# Для скольких лучших по оценке закупок считать ожидаемую маржу после каждой синхронизации
RESALE_ECONOMICS_PER_SYNC=30
# Для скольких лучших по марже закупок сам искать поставщиков после синхронизации (0 — только по кнопке)
RESALE_AUTO_SEARCH_PER_SYNC=5
# Минимальная ожидаемая маржа, %, чтобы запускать автопоиск
RESALE_MIN_MARGIN_PCT=15
# Этап 6b: для скольких перспективных закупок сам скачивать и читать ТЗ — за синхронизацию и за сутки.
# Разбор документации — модель Max (~30–80 тыс. токенов на закупку; бесплатный пакет — 25 млн в год).
RESALE_DOCS_PER_SYNC=10
RESALE_DOCS_PER_DAY=20
# Перечитывание без кнопки: разбор сделан прежней версией или упал по временной причине (ЕИС не отдал файлы, у
# нейросети кончился запас). При открытии карточки закупки сервис читает документы заново — не больше стольких
# в сутки (0 — выключить) и не чаще чем раз в REREAD_RETRY_HOURS часов по одной закупке.
# REREAD_ON_OPEN_PER_DAY=15
# REREAD_RETRY_HOURS=6
# Узлы поставок для оценки доставки до поиска поставщика: код региона:название через запятую
# RESALE_HUBS=77:Москва,78:Санкт-Петербург,66:Екатеринбург,54:Новосибирск,23:Краснодар
# Не больше стольких страниц с одного сайта на позицию
SEARCH_MAX_PAGES_PER_DOMAIN=3
# «Простой» запрос на позицию — наименование и модель или главные характеристики, как ищет человек (+1 платный запрос)
# SEARCH_PLAIN_QUERY=1
# Суточный лимит платных запросов к Яндекс Search API на весь сервис
SEARCH_DAILY_MAX_API_REQUESTS=200

# ---------- Telegram: уведомления о выгодных закупках и утренний дайджест ----------
# Токен бота от @BotFather. Пусто — бот не запускается, остальное работает.
TELEGRAM_BOT_TOKEN=
# Кому можно пользоваться ботом и кому слать дайджест: chat id через запятую.
# Узнать свой chat id: напишите боту /start — он ответит.
TELEGRAM_ALLOWED_CHAT_IDS=
# Время ежедневного дайджеста и часовой пояс
DIGEST_TIME=08:30
DIGEST_TZ=Europe/Moscow
# Адрес сервиса для ссылок в сообщениях бота
PUBLIC_BASE_URL=http://localhost:8850

# ---------- openai-compatible ----------
# Любой сервер с OpenAI Chat Completions API:
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:14b   (ключ не нужен)
#   vLLM:        LLM_BASE_URL=http://localhost:8000/v1    LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=deepseek/deepseek-chat
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# json_object — просить у сервера строгий JSON (если сервер не поддерживает, поставьте none)
LLM_JSON_MODE=json_object

# ---------- gigachat ----------
# Ключ авторизации (Authorization key) из личного кабинета developers.sber.ru — уже в base64.
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Сильная модель — для разбора документации, резюме и правовой проверки. У бесплатного тарифа запас токенов у каждой
# модели свой и выдаётся на год: Max — 25 млн, Pro — 40 млн, Lite — 250 млн. Остаток: GET /api/v1/balance.
# Запас Max при автоматических разборах уходит за три недели, поэтому по умолчанию — Pro.
GIGACHAT_MODEL=GigaChat-2-Pro
# Какие задачи идут облегчённой моделью (через запятую). Извлечение условий из документов (extract) на Lite
# заметно хуже — см. docs/full-reading-report.md; позиции и требования ТЗ читаются правилами, без нейросети.
# GIGACHAT_LITE_TASKS=score,resale_score,same_product
# Модель для массовой оценки ленты (облегчённая, бесплатный лимит больше). Запросы к GigaChat идут по одному, на 429 — повтор.
GIGACHAT_SCORE_MODEL=GigaChat-2
# Сертификат НУЦ Минцифры уже лежит в папке certs/ и подключается автоматически.

# ---------- yandexgpt ----------
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и ID каталога Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt/latest, yandexgpt-lite/latest, yandexgpt/rc и т.п.
YANDEX_MODEL=yandexgpt/latest

# ---------- Источники закупок (этап 6a) ----------
# Несколько источников сразу, через запятую и по порядку важности: gosplan (API с извещениями и контрактами),
# eis-rss (официальная лента поиска ЕИС — бесплатно и без ключа), fixture (сохранённые примеры, без сети).
# Закупка из разных источников склеивается по «закон + номер»; документы берутся у первого, кто их умеет.
TENDER_SOURCES=gosplan,eis-rss
# Пауза между запросами к ЕИС, мс. robots.txt ЕИС требует 60 секунд — меньше не ставьте.
EIS_REQUEST_DELAY_MS=60000
# Сколько страниц ленты ЕИС читать на одно ключевое слово (на странице до 200 закупок)
EIS_MAX_PAGES=3
