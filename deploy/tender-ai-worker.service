[Unit]
Description=tender-ai — рабочий процесс агентов (ночной агент базы товаров, агент заявок)
After=network-online.target tender-ai.service
Wants=network-online.target

[Service]
Type=simple
User=tender
Group=tender
WorkingDirectory=/opt/tender-ai
ExecStart=/usr/bin/node /opt/tender-ai/server/worker.js
Restart=always
RestartSec=10
# сайт важнее: агентам — меньший приоритет процессора и диска
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tender-ai
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
