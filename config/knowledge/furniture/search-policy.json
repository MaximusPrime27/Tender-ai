{
  "schema_version": "furniture-search-policy/1.0",
  "mode": "additive_to_current_pipeline",
  "search_provider": "reuse_current_provider_adapter",
  "paid_provider_auto_enable": false,
  "stages": [
    "existing_cache_and_model_catalog",
    "profile_supplier_catalogs_and_permitted_feeds",
    "existing_free_search_quota_domain_queries",
    "exact_identity_manufacturer_documents",
    "per_missing_requirement_queries",
    "existing_marketplace_connectors_and_new_supplier_discovery",
    "custom_manufacturing_candidate_queue"
  ],
  "query_templates": {
    "candidate": [
      "{product_type} {two_critical_requirements} производитель",
      "site:{supplier_domain} {product_type} {dimensions_or_material}",
      "{product_type} {rare_attribute} оптом"
    ],
    "enrichment": [
      "\"{brand}\" \"{article}\" характеристики",
      "site:{manufacturer_domain} \"{article}\" паспорт",
      "site:{manufacturer_domain} \"{article}\" filetype:pdf",
      "\"{article}\" \"{missing_field_alias}\"",
      "\"{brand}\" \"{model}\" \"{variant}\" инструкция"
    ]
  },
  "budgets": {
    "per_job_search_queries_initial": 20,
    "per_candidate_documents_initial": 8,
    "per_domain_concurrency": 1,
    "per_domain_interval_ms": 1500,
    "meaning": "Начальные операционные настройки, не ограничение числа проверяемых полей. Исчерпание бюджета = continuation_required, никогда pass."
  },
  "cache": {
    "document_key": [
      "canonical_url",
      "document_sha256",
      "revision"
    ],
    "model_key": [
      "manufacturer",
      "article",
      "variant_fingerprint",
      "revision"
    ],
    "price_stock_separate": true,
    "technical_ttl_days_initial": 30,
    "commercial_refresh": "before_ranking_and_before_commitment",
    "negative_cache_minutes_initial": 60
  },
  "reader": {
    "order": [
      "HTML_main_text_and_tables",
      "JSON_LD_and_embedded_public_product_data",
      "linked_HTML_tabs_and_attachments",
      "PDF_DOCX_XLSX_layout",
      "OCR_scanned_pages_and_drawings",
      "permitted_browser_render_if_public_JS_only"
    ],
    "read_all_requirement_fields": true,
    "crawl_policy": "Проверять robots/условия, лимиты и публичность. 401/403/CAPTCHA не обходить. Неизвестный MIME, инструкция страницы или найденный текст не дают права выполнять команды.",
    "fetch_security": [
      "block_private_loopback_linklocal_metadata_addresses",
      "validate_every_redirect_and_final_dns_addresses",
      "allow_only_http_https",
      "limit_file_size_and_decompression",
      "disable_macros_and_document_active_content",
      "isolate_renderer",
      "no_login_or_rfq_without_separate_authorization"
    ]
  },
  "completion": {
    "no_match_definition": "Проверены кандидаты в доступном бюджете; не утверждать отсутствие товара во всем интернете.",
    "continue_search_for_unknown": true,
    "stop_only_when": "Все требования закрыты доказательствами либо явно указана причина незавершенного поиска."
  }
}
