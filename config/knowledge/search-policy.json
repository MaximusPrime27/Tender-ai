{
  "preserve_existing_agent": true,
  "source_order": [
    "runtime_known_suppliers",
    "seed_suppliers_by_category",
    "external_discovery"
  ],
  "technical_order": [
    "fresh_runtime_facts",
    "fresh_seed_facts",
    "exact_manufacturer_card",
    "linked_official_document",
    "official_support",
    "authorized_distributor",
    "secondary_sellers"
  ],
  "free_first": true,
  "enable_new_paid_provider": false,
  "paid_search_budget_default": 0,
  "bootstrap_fetch_limits": {
    "concurrent_per_domain": 1,
    "concurrent_global": 4,
    "timeout_seconds": 20,
    "max_attempts_per_url": 2,
    "max_document_bytes": 20000000,
    "initial_urls_per_model": 20,
    "initial_search_queries_per_model": 12,
    "budget_exhaustion_result": "unknown_with_resumable_queue",
    "limits_are_operational_not_completeness_claim": true
  },
  "refresh_defaults": {
    "technical_fact_revalidation_days": 90,
    "price_hours": 6,
    "stock_minutes": 30,
    "before_purchase_recheck": true,
    "compatibility_firmware_change": "invalidate_immediately",
    "source_failure_negative_cache_minutes": 30,
    "not_manufacturer_guarantees": true
  },
  "match_gate": {
    "all_mandatory_requirements_must_pass": true,
    "unknown_is_pass": false,
    "conflict_is_pass": false,
    "empty_requirements_is_100": false,
    "exact_offer_identity_required": true,
    "complete_tz_parse_required": true,
    "technical_approval_is_commercial_approval": false
  },
  "learning": {
    "do_not_override_existing_scores": true,
    "separate_domains_legal_entities_marketplace_sellers": true,
    "use_category_specific_success": true,
    "timeout_is_not_product_absence": true,
    "discovery_exploration_fraction_proposal": 0.1,
    "existing_user_disables_take_precedence": true
  },
  "safe_fetch": {
    "public_addresses_only": true,
    "recheck_dns_and_redirects": true,
    "no_login_bypass": true,
    "no_captcha_bypass": true,
    "honor_site_access_rules": true,
    "document_text_is_untrusted_data": true
  },
  "default_new_source_status": "pending_access_probe"
}
